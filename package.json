{
  "name": "linea",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:math-viz": "pnpm --filter math-visual-test dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:docs": "pnpm --filter docs build",
    "build:math-viz": "pnpm --filter math-visual-test build",
    "lint": "pnpm -r lint",
    "lint:web": "pnpm --filter web lint",
    "lint:utils": "pnpm --filter @linea/utils lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:math": "pnpm --filter \"@cc/math\" test",
    "test:math:run": "pnpm --filter \"@cc/math\" test:run",
    "test:math:coverage": "pnpm --filter \"@cc/math\" test:coverage",
    "preview:web": "pnpm --filter web preview",
    "preview:docs": "pnpm --filter docs preview",
    "preview:math-viz": "pnpm --filter math-visual-test preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "5.7.1",
    "typescript": "5.9.3",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "typescript-eslint": "^8.54.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
