{
  "name": "linea",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:core-flow-test": "pnpm --filter core-flow-test dev",
    "dev:math-visual-test": "pnpm --filter math-visual-test dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter @ccpc/math build && pnpm --filter @ccpc/core build && pnpm --filter @ccpc/canvas build && pnpm --filter @ccpc/snap build && pnpm --filter @ccpc/platform build",
    "publish:lib": "pnpm --filter @ccpc/math publish && pnpm --filter @ccpc/core publish && pnpm --filter @ccpc/canvas publish && pnpm --filter @ccpc/snap publish && pnpm --filter @ccpc/platform publish",
    "build:docs": "pnpm --filter docs build",
    "build:math-visual-test": "pnpm --filter math-visual-test build",
    "publish:core": "pnpm --filter @ccpc/core publish --access public --no-git-checks",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:math": "pnpm --filter \"@ccpc/math\" test",
    "test:math:run": "pnpm --filter \"@ccpc/math\" test:run",
    "test:math:coverage": "pnpm --filter \"@ccpc/math\" test:coverage",
    "preview:docs": "pnpm --filter docs preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "5.7.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "rimraf": "^6.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vue-eslint-parser": "^10.2.0"
  }
}
