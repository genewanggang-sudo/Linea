{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "experimentalDecorators": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "src/**/*.vue"
  ]
}