{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "vitest/globals",
            "node"
        ],
        "noEmit": true,
        "allowJs": true,
        "baseUrl": ".",
        "paths": {
            "@ccpc/math": [
                "packages/math/src/index.ts"
            ],
            "@ccpc/core": [
                "packages/core/src/index.ts"
            ],
            "@ccpc/canvas": [
                "packages/canvas/src/index.ts"
            ],
            "@ccpc/platform": [
                "packages/platform/src/index.ts"
            ]
        },
        "strict": true,
    },
    "include": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "apps/**/*.vue",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "packages/**/*.vue",
        "scripts/**/*.ts",
        "tests/**/*.ts"
    ]
}