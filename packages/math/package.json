{
    "name": "@ccpc/math",
    "version": "0.1.16",
    "private": false,
    "description": "2D geometry and curve math library",
    "license": "MIT",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "build": "rimraf dist && vite build && node scripts/patch-dist-package.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
        "publish": "cd dist && pnpm publish --access public --git-checks=false",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@types/earcut": "^3.0.0",
        "@types/lodash": "^4.17.24",
        "@types/numeric": "^1.2.6",
        "@types/priorityqueuejs": "^1.0.4",
        "@vitest/coverage-v8": "^4.0.18",
        "vite-plugin-top-level-await": "^1.6.0",
        "vite-plugin-wasm": "^3.5.0",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "clipper2-wasm": "^0.2.1",
        "earcut": "^3.0.2",
        "libtess": "^1.2.2",
        "lodash": "^4.17.23",
        "numeric": "^1.2.6",
        "poly2tri": "^1.5.0",
        "priorityqueuejs": "^2.0.0",
        "quadtree-lib": "^1.0.9",
        "uuid": "^10.0.0"
    }
}
