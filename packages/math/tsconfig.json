{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "experimentalDecorators": true,
        "declaration": true,
        // "declarationMap": true,
        "emitDeclarationOnly": false,
        "strictPropertyInitialization": true,
        "noImplicitAny": false,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        // 下面这些是从老项目配置里拿过来的兼容项，先集中放在一起，后续方便统一评估是否保留
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/clipperlib/**/*.js",
        "src/verb/**/*.js",
        "src/wasm/**/*.js"
    ]
}